# Novalup AI — PRODUCTION env. Copy to `.env.production` ON THE SERVER and fill in.
#   cp .env.production.example .env.production
#
# Consumed by:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The real `.env.production` is gitignored — keep it only on the server, never commit it.

# --- Traefik ---
#   The Docker network your existing Traefik is attached to (the app containers
#   join it so Traefik can route to them). NOT the Traefik container name.
#   Find it on the server with:
#     docker inspect <traefik-container> -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
#   Commonly "traefik_default". Defaults to "web" if unset.
TRAEFIK_NETWORK=traefik_default

# --- Postgres (runs as a container, volume-backed: `pgdata`) ---
POSTGRES_USER=novalup
POSTGRES_PASSWORD=            # REQUIRED — strong unique password, NOT "novalup"
POSTGRES_DB=product_photos
# DATABASE_URL is assembled by docker-compose.prod.yml from the POSTGRES_* vars
# above (host "postgres"). Do not set it here.

# --- Auth (Auth.js v5) ---
NEXTAUTH_SECRET=              # REQUIRED — generate with: openssl rand -base64 32
NEXTAUTH_URL=https://photos.novaluptech.com
GOOGLE_CLIENT_ID=            # Google Cloud Console → OAuth 2.0 Web client
GOOGLE_CLIENT_SECRET=
#   Add in Google Cloud Console for that client:
#     Authorized redirect URI:      https://photos.novaluptech.com/api/auth/callback/google
#     Authorized JavaScript origin: https://photos.novaluptech.com

# --- Kie.ai (Nano Banana 2) ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=nano-banana-2
KIE_RESOLUTION=2K

# --- Cloudinary — hosts uploaded reference images and generated results ---
CLOUDINARY_CLOUD_NAME=duz1soadb
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=product-photos

# --- Feedback (FormSubmit) ---
#   The first submission from photos.novaluptech.com triggers a one-time
#   activation email — click the link in it or feedback delivery stays disabled.
FORMSUBMIT_EMAIL=

# --- Credits & limits ---
FREE_CREDITS=3
MAX_UPLOAD_MB=10

# --- Marketing site (apps/web) ---
#   Inlined into the web bundle at BUILD time (compose passes it as a build arg,
#   so a redeploy with --build is required after changing it).
NEXT_PUBLIC_PRODUCT_PHOTOS_URL=https://photos.novaluptech.com
