# Novalup AI — Product Photos MVP. Copy to `.env` and fill the blanks:
#   cp .env.example .env
#
# Used by `docker compose` (see docker-compose.yml) and by local `pnpm dev`.
# NOTE on DATABASE_URL: under `docker compose` the product-photos service sets
# its own DATABASE_URL pointing at host "postgres". The value below (host
# "localhost") is for running the app with `pnpm --filter product-photos dev`
# against `docker compose up postgres`.

# Database
POSTGRES_USER=novalup
POSTGRES_PASSWORD=novalup
POSTGRES_DB=product_photos
DATABASE_URL=postgresql://novalup:novalup@localhost:5432/product_photos

# Auth (next-auth v5 / Auth.js)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kie.ai (Nano Banana 2)
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=nano-banana-2
KIE_RESOLUTION=2K

# Cloudinary — hosts uploaded reference images and generated results. Reference
# images and results are stored under CLOUDINARY_FOLDER with random public_ids.
CLOUDINARY_CLOUD_NAME=duz1soadb
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=product-photos

# Feedback (FormSubmit — requires a one-time activation on first send)
FORMSUBMIT_EMAIL=

# Credits & limits
FREE_CREDITS=3
MAX_UPLOAD_MB=10

# Link from the marketing homepage (apps/web) to this app
NEXT_PUBLIC_PRODUCT_PHOTOS_URL=http://localhost:3000
